{
  "name": "@heraldserver/gateway",
  "version": "0.1.0",
  "description": "Gateway de referência (middleware Express) para o Herald Protocol.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bash -c 'shopt -s globstar; node --test dist/**/*.test.js'",
    "load-test": "node --expose-gc scripts/load-test.mjs"
  },
  "dependencies": {
    "@heraldserver/sdk": "file:../sdk",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "herald-protocol",
    "gateway",
    "middleware",
    "express"
  ]
}

{
  "name": "@heraldserver/cli",
  "version": "0.1.0",
  "description": "CLI de referência para provisionar um Herald Outpost e configurar @heraldserver/gateway na sua aplicação.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "herald": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "test": "bash -c 'shopt -s globstar; node --test dist/**/*.test.js'"
  },
  "dependencies": {
    "@heraldserver/server": "file:../server",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "herald-protocol",
    "cli",
    "outpost"
  ]
}
